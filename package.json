{
  "name": "quint",
  "version": "2.2.0",
  "description": "Quint - the world's easiest Minecraft plugin creator. Drag-and-connect, block-based plugin building (Scratch-style) with real Java/Paper output and jar auto-decompilation, entirely in the browser -- no install, no server.",
  "main": "electron-main.js",
  "repository": "deadbytee-del/Quint",
  "author": "deadbytee-del",
  "license": "MIT",
  "scripts": {
    "dev": "npx serve public",
    "electron:dev": "electron .",
    "dist": "electron-builder --publish=never",
    "release": "electron-builder --publish=always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "serve-handler": "^6.1.6"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.quint.app",
    "productName": "Quint",
    "publish": {
      "provider": "github",
      "owner": "deadbytee-del",
      "repo": "Quint",
      "releaseType": "release"
    },
    "files": [
      "electron-main.js",
      "electron-preload.js",
      "public/**/*",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quint"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
