{
  "appId": "com.quint.au",
  "productName": "AU-Quint",
  "extraMetadata": {
    "name": "au-quint"
  },
  "publish": {
    "provider": "github",
    "owner": "deadbytee-del",
    "repo": "Quint",
    "releaseType": "release",
    "channel": "au"
  },
  "files": [
    "electron-main.js",
    "electron-preload.js",
    "public/**/*",
    "build/icon.png"
  ],
  "directories": {
    "output": "dist-au"
  },
  "win": {
    "target": ["nsis", "portable"]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "AU-Quint"
  },
  "mac": {
    "target": [
      { "target": "dmg", "arch": ["x64", "arm64"] },
      { "target": "zip", "arch": ["x64", "arm64"] },
      { "target": "pkg", "arch": ["x64", "arm64"] }
    ],
    "category": "public.app-category.education",
    "minimumSystemVersion": "10.15.0"
  },
  "pkg": {
    "installLocation": "/Applications"
  },
  "linux": {
    "target": ["AppImage", "deb", "rpm"],
    "category": "Education"
  }
}
